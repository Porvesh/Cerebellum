CompileFlags:
  # Clang 14 incorrectly selects the incomplete GCC 12 installation on this
  # machine; libstdc++ is installed for GCC 11.
  Remove: [-std=*]
  Add:
    - -std=c++20
    - -isystem
    - /usr/include/c++/11
    - -isystem
    - /usr/include/x86_64-linux-gnu/c++/11
    - -isystem
    - /usr/include/c++/11/backward
    - -I/shared/porvesh/test/robotics/Cerebellum/include

