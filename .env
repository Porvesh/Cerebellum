# Cerebellum run environment.
#
#   set -a; source .env; set +a
#
# This file is committed on purpose. These values change measured p99, so they
# are part of every result's conditions — an env var that moves the tail and
# isn't written down turns a measurement into an anecdote (spec.md §9).
# Secrets (HF token, wandb key) go in .env.local, which is gitignored.

# ---------------------------------------------------------------------------
# Paths and targeting
# ---------------------------------------------------------------------------

# Nsight Systems, extracted from the .deb without root. Installed 2026-08-02.
# PATH is deliberately not set here: every value in this file is a plain
# assignment, which keeps repeated sourcing idempotent (and keeps the file
# parseable by things that aren't a shell). The conda activate hook prepends
# $NSYS_HOME to PATH, guarded. To do it by hand:
#     export PATH="$NSYS_HOME:$PATH"
NSYS_HOME=/shared/porvesh/opt/nsight-systems/opt/nvidia/nsight-systems-cli/2026.4.1/target-linux-x64

# HF cache. NOT the default ~/.cache/huggingface — the root disk is full.
HF_HOME=/shared/porvesh/hf
HF_HUB_ENABLE_HF_TRANSFER=1

# GPU 2. Cards 0/1/3 are reserved by an unrelated pipeline-parallel workload.
# Pinning here means the code always
# talks to cuda:0 and never hardcodes a physical index, and it makes landing on
# a shared card impossible rather than merely unlikely.
CUDA_VISIBLE_DEVICES=2

# ---------------------------------------------------------------------------
# Variance control — p99 is the product (spec.md §9)
# ---------------------------------------------------------------------------

# torch defaults OMP threads to core count. Those threads fight the control
# thread for CPU and inject jitter into the one thread that has a deadline.
# Batch-1 GPU inference needs approximately no CPU parallelism.
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1

# HF tokenizers otherwise spawns background threads and warns about forks.
TOKENIZERS_PARALLELISM=false

# ---------------------------------------------------------------------------
# Deliberately NOT set. Kept here so the reasoning doesn't get lost.
# ---------------------------------------------------------------------------

# CUDA_LAUNCH_BLOCKING=1
#   Makes every launch synchronous. Excellent for debugging a crash, and it
#   destroys every number this project collects. If a measurement looks insane,
#   check this first.

# CUBLAS_WORKSPACE_CONFIG=:4096:8
#   Required alongside torch.use_deterministic_algorithms(True). Costs
#   performance, so it belongs to phase 2's bit-exact replay work (spec.md
#   §10.2.5), not to the default environment.

# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
#   May remove allocator stalls from the tail. Do not set blind — measure it as
#   one of the one-change-at-a-time optimisations in phase 1 step 5.
