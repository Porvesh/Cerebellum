# secrets only — .env itself is committed, it is a run condition
.env.local

# build output
/build/
/build-*/

# clangd's flags: cmake writes them into build/, symlinked here (machine-local)
/compile_commands.json

# compiled
*.o
*.a

# python (the model side only — the runtime is C++)
__pycache__/
*.py[cod]
.venv/

# measurement output — results/*.csv and results/*.png are committed on purpose
# (see spec.md §11); these are the raw traces behind them, which are not
results/raw/
*.nsys-rep
*.sqlite
trace_*.json

# model weights / caches — never committed (HF_HOME points at /shared)
*.safetensors
*.pt
.cache/

# editor / OS cruft
.DS_Store
*.swp
.vscode/
.idea/

# personal/local agent state — never commit
.codex
